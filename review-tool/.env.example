# Environment Configuration for Claude Code Skills Review Tool
# Copy this file to .env and customize for your environment

# =============================================================================
# User Permissions (Auto-generated)
# =============================================================================
# These are automatically set by review-cli.py or test-setup.sh
# to match your user's UID/GID for proper file permissions
USER_ID=1000
GROUP_ID=1000

# =============================================================================
# Anthropic Claude API Key (Optional)
# =============================================================================
# Only needed if NOT using --use-claude-cli flag
# Get your API key from: https://console.anthropic.com/
# Models: claude-sonnet-4-20250514, claude-opus-4-20250514
ANTHROPIC_API_KEY=

# =============================================================================
# Usage
# =============================================================================
#
# RECOMMENDED: Use Claude CLI (no API key needed)
# ------------------------------------------------
# 1. Authenticate once: claude login
# 2. Run with --use-claude-cli flag
#
#    ./review-cli.py \
#      --repo https://github.com/user/repo \
#      --reviewer python \
#      --use-claude-cli
#
# ALTERNATIVE: Use API Key
# ------------------------------------------------
# 1. Copy this file: cp .env.example .env
# 2. Edit .env and add your ANTHROPIC_API_KEY
# 3. Run without --use-claude-cli flag
#
#    ./review-cli.py \
#      --repo https://github.com/user/repo \
#      --reviewer python
#
# =============================================================================
# Security Notes
# =============================================================================
#
# - NEVER commit .env file to version control
# - .env is already in .gitignore
# - Claude CLI is recommended (uses OAuth, no keys to manage)
# - If using API keys: rotate regularly and monitor usage
#
